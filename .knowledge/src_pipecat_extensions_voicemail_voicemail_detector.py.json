{"is_source_file": true, "format": "Python", "description": "This file implements a voicemail detection module for the Pipecat outbound calling system using parallel pipeline architecture. It contains classes for gate control based on external notifications, voicemail classification via LLM responses, and TTS gating to prevent playback until decision is made. The core logic includes managing state machines for LLM response aggregation, event handling for voicemail detection, and pipeline control for outbound call processing.", "external_files": ["pipecat.frames.frames", "pipecat.pipeline.parallel_pipeline", "pipecat.processors.aggregators.llm_response_universal", "pipecat.processors.frame_processor", "pipecat.services.llm_service", "pipecat.turns.user_turn_strategies", "pipecat.utils.sync.base_notifier", "pipecat.utils.sync.event_notifier"], "external_methods": ["asyncio.Task", "asyncio.wait_for", "asyncio.sleep", "BaseNotifier.wait", "EventNotifier.notify"], "published": ["VoicemailDetector", "VoicemailDetector.CLASSIFIER_RESPONSE_INSTRUCTION"], "classes": [{"name": "NotifierGate", "description": "Base gate class controlling frame flow based on an external notifier signal, allowing frames when open and blocking when closed."}, {"name": "ClassifierGate", "description": "Gate controlling frame flow based on classification decisions ('CONVERSATION' or 'VOICEMAIL'), closing after decision to block further classification frames."}, {"name": "ConversationGate", "description": "Gate that blocks further conversation frames when voicemail is detected, allowing only system and user speaking frames."}, {"name": "ClassificationProcessor", "description": "Processes LLM responses to classify calls as human conversation or voicemail, manages response aggregation, and triggers corresponding events."}, {"name": "TTSGate", "description": "Gates TTS frames while voicemail classification is pending, releasing frames on conversation detection or clearing them on voicemail detection."}, {"name": "VoicemailDetector", "description": "Parallel pipeline for real-time voicemail vs. conversation classification in outbound calls, integrating several gating, classification, and event handling components."}], "methods": [{"name": "None _validate_prompt(self, prompt: str)", "description": "Validates that a custom system prompt instructs the LLM to respond with 'CONVERSATION' or 'VOICEMAIL'.", "scope": "VoicemailDetector", "scopeKind": "class"}, {"name": "\"VoicemailDetector\" detector(self)", "description": "Returns the parallel pipeline instance for placement after STT in the call flow.", "scope": "VoicemailDetector", "scopeKind": "class"}, {"name": "TTSGate gate(self)", "description": "Returns the TTS gate processor for placement after TTS in the pipeline.", "scope": "VoicemailDetector", "scopeKind": "class"}, {"name": "add_event_handler(self, event_name: str, handler)", "description": "Allows registration of custom event handlers for voicemail or conversation detection events.", "scope": "VoicemailDetector", "scopeKind": "class"}, {"name": "__init__( self, *, gate_notifier: BaseNotifier, conversation_notifier: BaseNotifier, voicemail_notifier: BaseNotifier, voicemail_response_delay: float, )", "scope": "ClassificationProcessor", "scopeKind": "class", "description": "unavailable"}, {"name": "__init__( self, *, llm: LLMService, voicemail_response_delay: float = 2.0, custom_system_prompt: Optional[str] = None, )", "scope": "VoicemailDetector", "scopeKind": "class", "description": "unavailable"}, {"name": "__init__(self, conversation_notifier: BaseNotifier, voicemail_notifier: BaseNotifier)", "scope": "TTSGate", "scopeKind": "class", "description": "unavailable"}, {"name": "__init__(self, gate_notifier: BaseNotifier, conversation_notifier: BaseNotifier)", "scope": "ClassifierGate", "scopeKind": "class", "description": "unavailable"}, {"name": "__init__(self, notifier: BaseNotifier, task_name: str = \"gate\")", "scope": "NotifierGate", "scopeKind": "class", "